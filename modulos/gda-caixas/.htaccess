Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteRule ^p/([A-Za-z0-9_-]{43})/comprovante/([a-f0-9]{48}\.[a-z0-9]+)$ index.php?page=receipt_file&access_token=$1&receipt_token=$2 [QSA,L]
RewriteRule ^p/([A-Za-z0-9_-]{43})/?$ index.php?page=participant_portal&access_token=$1 [QSA,L]
</IfModule>

<FilesMatch "^(README\.md|.*\.sql|.*\.example)$">
  Require all denied
</FilesMatch>
